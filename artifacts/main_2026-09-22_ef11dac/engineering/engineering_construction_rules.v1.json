{
  "schema_version": "engineering_construction_rules.v1",
  "description": "Deterministic construction rulebook mapping frozen repository_facts.v2 observations to EngineeringModel nodes, relationships, identities, evidence, unresolved candidates, and validation invariants. This file is the rulebook, not the graph.",
  "input": {
    "fact_schema": "repository_facts.v2",
    "notes": "Read repository observations exclusively from facts[]. Do not use counts() or removed repository.files keys."
  },
  "classification_vocabulary": [
    "observed",
    "derived",
    "inferred",
    "conflicting"
  ],
  "node_vocabulary": [
    {
      "kind": "artifact",
      "subkinds": [
        "file",
        "directory",
        "agent_definition",
        "agent_command",
        "agent_config",
        "mcp_config",
        "mcp_server_source"
      ]
    },
    {
      "kind": "code_entity",
      "subkinds": [
        "module",
        "class",
        "function"
      ]
    },
    {
      "kind": "external_package",
      "subkinds": [
        "package"
      ]
    },
    {
      "kind": "tool",
      "subkinds": [
        "mcp",
        "built_in"
      ]
    },
    {
      "kind": "mcp_server",
      "subkinds": [
        "registered"
      ]
    }
  ],
  "relationship_vocabulary": [
    "IMPORTS",
    "DEPENDS_ON",
    "CONTAINS",
    "TRIGGERS",
    "DECLARES",
    "EXPOSED_BY",
    "CONFIGURED_BY"
  ],
  "node_rules": [
    {
      "rule_id": "node.file.repository_file",
      "match": {
        "fact_type": "file",
        "kind": "repository_file"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "file"
      },
      "identity": {
        "template": "artifact:file:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "Canonical physical file node. Configuration/documentation/test facts for the same path must not create a second file node."
    },
    {
      "rule_id": "node.directory.repository_directory",
      "match": {
        "fact_type": "directory",
        "kind": "repository_directory"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "directory"
      },
      "identity": {
        "template": "artifact:directory:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity"
    },
    {
      "rule_id": "node.entity.module",
      "match": {
        "fact_type": "entity",
        "kind": "module"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "code_entity",
        "subkind": "module"
      },
      "identity": {
        "template": "code_entity:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "Identity describes the engineering module (repository path), not the analyzer that discovered it (no python-module:/ast-module: prefixes)."
    },
    {
      "rule_id": "node.entity.class",
      "match": {
        "fact_type": "entity",
        "kind": "class"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "code_entity",
        "subkind": "class"
      },
      "identity": {
        "template": "code_entity:{entity_key}",
        "from_attributes": [
          "path",
          "qualified_name"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "Identity normalizes M2 path + qualified_name so the repository path appears once (e.g. code_entity:src/service.py::Service)."
    },
    {
      "rule_id": "node.entity.function",
      "match": {
        "fact_type": "entity",
        "kind": "function"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "code_entity",
        "subkind": "function"
      },
      "identity": {
        "template": "code_entity:{entity_key}",
        "from_attributes": [
          "path",
          "qualified_name"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "Identity normalizes M2 path + qualified_name so the repository path appears once (e.g. code_entity:src/service.py::run). Redefined symbols share qualified_name; line is not part of node identity in V1."
    },
    {
      "rule_id": "node.artifact.agent_definition",
      "match": {
        "fact_type": "artifact",
        "kind": "agent_definition"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "agent_definition"
      },
      "identity": {
        "template": "artifact:agent_definition:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "Specialized repository artifact. Not architecture concept:agent / service / workflow."
    },
    {
      "rule_id": "node.artifact.agent_command",
      "match": {
        "fact_type": "artifact",
        "kind": "agent_command"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "agent_command"
      },
      "identity": {
        "template": "artifact:agent_command:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity"
    },
    {
      "rule_id": "node.artifact.agent_config",
      "match": {
        "fact_type": "artifact",
        "kind": "agent_config"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "agent_config"
      },
      "identity": {
        "template": "artifact:agent_config:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity"
    },
    {
      "rule_id": "node.artifact.mcp_config",
      "match": {
        "fact_type": "artifact",
        "kind": "mcp_config"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "mcp_config"
      },
      "identity": {
        "template": "artifact:mcp_config:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity"
    },
    {
      "rule_id": "node.artifact.mcp_server_source",
      "match": {
        "fact_type": "artifact",
        "kind": "mcp_server_source"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "artifact",
        "subkind": "mcp_server_source"
      },
      "identity": {
        "template": "artifact:mcp_server_source:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity"
    },
    {
      "rule_id": "node.artifact.mcp_documentation",
      "match": {
        "fact_type": "artifact",
        "kind": "mcp_documentation"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "mcp_documentation"
      },
      "identity": {
        "template": "artifact:mcp_documentation:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: describes an aspect of a path that already has (or may have) a canonical file/artifact node."
    },
    {
      "rule_id": "node.artifact.markdown",
      "match": {
        "fact_type": "artifact",
        "kind": "markdown"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "markdown"
      },
      "identity": {
        "template": "artifact:markdown:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: same physical file may already be artifact:file."
    },
    {
      "rule_id": "node.artifact.python",
      "match": {
        "fact_type": "artifact",
        "kind": "python"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "python"
      },
      "identity": {
        "template": "artifact:python:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: MCP/python side facts; module nodes come from entity/module."
    },
    {
      "rule_id": "node.artifact.shell",
      "match": {
        "fact_type": "artifact",
        "kind": "shell"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "shell"
      },
      "identity": {
        "template": "artifact:shell:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: same physical file may already be artifact:file."
    },
    {
      "rule_id": "node.configuration.file",
      "match": {
        "fact_type": "configuration",
        "kind": "file"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "configuration"
      },
      "identity": {
        "template": "artifact:configuration:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: configuration is another classification of an existing repository file."
    },
    {
      "rule_id": "node.configuration.json",
      "match": {
        "fact_type": "configuration",
        "kind": "json"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "configuration"
      },
      "identity": {
        "template": "artifact:configuration:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: do not duplicate the physical file node."
    },
    {
      "rule_id": "node.configuration.toml",
      "match": {
        "fact_type": "configuration",
        "kind": "toml"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "configuration"
      },
      "identity": {
        "template": "artifact:configuration:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: do not duplicate the physical file node."
    },
    {
      "rule_id": "node.configuration.yaml",
      "match": {
        "fact_type": "configuration",
        "kind": "yaml"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "configuration"
      },
      "identity": {
        "template": "artifact:configuration:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: do not duplicate the physical file node."
    },
    {
      "rule_id": "node.documentation.documentation",
      "match": {
        "fact_type": "documentation",
        "kind": "documentation"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "documentation"
      },
      "identity": {
        "template": "artifact:documentation:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: documentation classification of an existing path."
    },
    {
      "rule_id": "node.documentation.markdown",
      "match": {
        "fact_type": "documentation",
        "kind": "markdown"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "documentation"
      },
      "identity": {
        "template": "artifact:documentation:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: do not create a second node solely because docs classification differs from file."
    },
    {
      "rule_id": "node.documentation.readme",
      "match": {
        "fact_type": "documentation",
        "kind": "readme"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "documentation"
      },
      "identity": {
        "template": "artifact:documentation:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only."
    },
    {
      "rule_id": "node.documentation.runbook",
      "match": {
        "fact_type": "documentation",
        "kind": "runbook"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "documentation"
      },
      "identity": {
        "template": "artifact:documentation:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only."
    },
    {
      "rule_id": "node.test.test_directory",
      "match": {
        "fact_type": "test",
        "kind": "test_directory"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "test"
      },
      "identity": {
        "template": "artifact:test:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: directory already has artifact:directory when present."
    },
    {
      "rule_id": "node.test.test_file",
      "match": {
        "fact_type": "test",
        "kind": "test_file"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "artifact",
        "subkind": "test"
      },
      "identity": {
        "template": "artifact:test:{path}",
        "from_attributes": [
          "path"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Evidence-only: do not duplicate artifact:file for the same path."
    },
    {
      "rule_id": "node.dependency.dependencies",
      "match": {
        "fact_type": "dependency",
        "kind": "dependencies"
      },
      "action": "EVIDENCE_ONLY",
      "node": {
        "kind": "external_package",
        "subkind": "package"
      },
      "identity": {
        "template": "external_package:{name}",
        "from_attributes": [
          "name"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Dependency facts primarily drive DEPENDS_ON relationship rules; external package nodes are created only when a DEPENDS_ON target is resolved (see relationship_rules). This entry documents the fact type without emitting a node by itself."
    },
    {
      "rule_id": "node.tool.mcp_tool",
      "match": {
        "fact_type": "tool",
        "kind": "mcp_tool"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "tool",
        "subkind": "mcp"
      },
      "identity": {
        "template": "tool:mcp:{server}:{name}",
        "from_attributes": [
          "server",
          "name"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "A tool exposed by an MCP server. Identity is the server-scoped name (the MCP calling identity server/tool) so two servers may legitimately expose same-named tools without ambiguity. Evidence must cite an explicit tool registry entry or an explicit namespaced agent tool declaration - never a Python function name or a doc mention."
    },
    {
      "rule_id": "node.tool.built_in_tool",
      "match": {
        "fact_type": "tool",
        "kind": "built_in_tool"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "tool",
        "subkind": "built_in"
      },
      "identity": {
        "template": "tool:builtin:{name}",
        "from_attributes": [
          "name"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "A tool declared by an agent without an MCP server namespace (bare entry in an explicit agent tool declaration). The built_in subkind states what the evidence shows - no server namespace - not which host runtime provides it. Declarations whose bare name also appears as an MCP tool name stay ambiguous (unresolved) instead of becoming this node."
    },
    {
      "rule_id": "node.mcp_server.registered",
      "match": {
        "fact_type": "mcp_server",
        "kind": "registered"
      },
      "action": "CREATE_NODE",
      "node": {
        "kind": "mcp_server",
        "subkind": "registered"
      },
      "identity": {
        "template": "mcp_server:{name}",
        "from_attributes": [
          "name"
        ],
        "deterministic": true
      },
      "classification": "observed",
      "requires_evidence": true,
      "dedupe_by": "identity",
      "notes": "Registered MCP server identity (name), established only by explicit configuration or tool-registry entries. Distinct from artifact/mcp_server_source (a path classification of a source file): the registered server is a semantic entity, the source file is an artifact."
    }
  ],
  "relationship_rules": [
    {
      "rule_id": "rel.import.import",
      "match": {
        "fact_type": "import",
        "kind": "import"
      },
      "action": "CREATE_RELATIONSHIP_IF_RESOLVED",
      "relationship": {
        "kind": "IMPORTS"
      },
      "source": {
        "resolve": "path_node",
        "from_attributes": [
          "path"
        ],
        "node_kind": "artifact",
        "node_subkind": "file",
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "missing_endpoint"
      },
      "target": {
        "resolve": "imported_module",
        "from_attributes": [
          "module"
        ],
        "strategies": [
          "exact_module_path",
          "dotted_module_to_path",
          "suffix_path_match"
        ],
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "target_not_resolved"
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Do not create IMPORTS if the target cannot be resolved confidently; emit an unresolved candidate instead. Unresolved targets (stdlib, third-party) are not manufactured as graph nodes from the module string alone."
    },
    {
      "rule_id": "rel.import.import_from",
      "match": {
        "fact_type": "import",
        "kind": "import_from"
      },
      "action": "CREATE_RELATIONSHIP_IF_RESOLVED",
      "relationship": {
        "kind": "IMPORTS"
      },
      "source": {
        "resolve": "path_node",
        "from_attributes": [
          "path"
        ],
        "node_kind": "artifact",
        "node_subkind": "file",
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "missing_endpoint"
      },
      "target": {
        "resolve": "imported_module",
        "from_attributes": [
          "module",
          "names"
        ],
        "strategies": [
          "exact_module_path",
          "dotted_module_to_path",
          "suffix_path_match"
        ],
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "target_not_resolved"
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "from foo.bar import Baz — resolve foo.bar (and/or Baz) only against known engineering entities/modules. Do not manufacture a target because the imported name string exists."
    },
    {
      "rule_id": "rel.dependency.dependencies",
      "match": {
        "fact_type": "dependency",
        "kind": "dependencies"
      },
      "action": "CREATE_RELATIONSHIP_IF_RESOLVED",
      "relationship": {
        "kind": "DEPENDS_ON"
      },
      "source": {
        "resolve": "path_node",
        "from_attributes": [
          "source"
        ],
        "node_kind": "artifact",
        "node_subkind": "file",
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "missing_endpoint"
      },
      "target": {
        "resolve": "external_package",
        "from_attributes": [
          "name"
        ],
        "strategies": [
          "declared_name"
        ],
        "node_kind": "external_package",
        "node_subkind": "package",
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "target_not_resolved"
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Target vocabulary is external_package:<name> (documented, evolvable). If name is missing or non-deterministic, unresolved — never a fake target. Future milestones may extend the external node vocabulary without redesigning the matrix."
    },
    {
      "rule_id": "rel.interaction.triggers",
      "match": {
        "fact_type": "interaction",
        "kind": "triggers"
      },
      "action": "CREATE_RELATIONSHIP_IF_RESOLVED",
      "relationship": {
        "kind": "TRIGGERS"
      },
      "source": {
        "resolve": "fact_node_identity",
        "from_attributes": [
          "source_fact_id"
        ],
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "missing_endpoint"
      },
      "target": {
        "resolve": "fact_node_identity",
        "from_attributes": [
          "target_fact_id"
        ],
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "target_not_resolved"
      },
      "classification": "observed",
      "requires_evidence": true,
      "notes": "Observed only when M2 captured an explicit trigger statement and both endpoint facts map to existing engineering nodes. Never inferred from co-location or name similarity. Unresolved endpoints stay in engineering.unresolved[] with retained evidence."
    },
    {
      "rule_id": "rel.contains.directory_file",
      "match": {
        "fact_type": "file",
        "kind": "repository_file"
      },
      "action": "CREATE_DERIVED_RELATIONSHIP",
      "relationship": {
        "kind": "CONTAINS"
      },
      "source": {
        "resolve": "path_node",
        "from_attributes": [
          "path"
        ],
        "node_kind": "artifact",
        "node_subkind": "directory",
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "missing_endpoint"
      },
      "target": {
        "resolve": "path_node",
        "from_attributes": [
          "path"
        ],
        "node_kind": "artifact",
        "node_subkind": "file",
        "on_failure": "UNRESOLVED",
        "unresolved_reason": "missing_endpoint"
      },
      "derive": {
        "condition": "parent_directory_of_file_path_exists_as_directory_node",
        "description": "Source directory path is the parent of the file path; both nodes exist from M2 path attributes."
      },
      "classification": "derived",
      "requires_evidence": true,
      "notes": "Derived from filesystem path structure, not from names alone. Evidence cites contributing file (and directory) facts."
    },
    {
      "rule_id": "rel.contains.file_module",
      "match": {
        "fact_type": "entity",
        "kind": "module"
      },

  "identity_rules": [
    {
      "rule_id": "id.node.artifact.file",
      "applies_to": "node",
      "template": "artifact:file:{path}",
      "stable_fields": [
        "path"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Repository-relative path only."
    },
    {
      "rule_id": "id.node.artifact.directory",
      "applies_to": "node",
      "template": "artifact:directory:{path}",
      "stable_fields": [
        "path"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ]
    },
    {
      "rule_id": "id.node.artifact.specialized",
      "applies_to": "node",
      "template": "artifact:{subkind}:{path}",
      "stable_fields": [
        "subkind",
        "path"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Specialized ADOP artifacts (agent_*, mcp_*). Subkind comes from M2 kind, not from analyzer name."
    },
    {
      "rule_id": "id.node.code_entity.module",
      "applies_to": "node",
      "template": "code_entity:{path}",
      "stable_fields": [
        "path"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Never python-module:, ast-module:, or tree-sitter-module:."
    },
    {
      "rule_id": "id.node.code_entity.class_function",
      "applies_to": "node",
      "template": "code_entity:{entity_key}",
      "stable_fields": [
        "path",
        "qualified_name"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "entity_key = normalize(path, qualified_name): use qualified_name when it already carries path context; otherwise path::qualified_name. Never duplicates the repository path. No analyzer names."
    },
    {
      "rule_id": "id.node.external_package",
      "applies_to": "node",
      "template": "external_package:{name}",
      "stable_fields": [
        "name"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Documented V1 external vocabulary; may evolve in later milestones without redesigning the full matrix."
    },
    {
      "rule_id": "id.relationship.default",
      "applies_to": "relationship",
      "template": "rel:{kind}:{source}:{target}",
      "stable_fields": [
        "kind",
        "source",
        "target"
      ],
      "forbidden": [
        "analyzer",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Stable for same source + same target + same relationship kind. No random UUIDs; no analyzer-specific identifiers."
    },
    {
      "rule_id": "id.node.tool.mcp",
      "applies_to": "node",
      "template": "tool:mcp:{server}:{name}",
      "stable_fields": [
        "server",
        "name"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Server-scoped tool identity (MCP calling identity). Never includes analyzer/source names."
    },
    {
      "rule_id": "id.node.tool.built_in",
      "applies_to": "node",
      "template": "tool:builtin:{name}",
      "stable_fields": [
        "name"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Namespace-free tool identity for explicitly declared agent tools. Never includes analyzer/source names."
    },
    {
      "rule_id": "id.node.mcp_server",
      "applies_to": "node",
      "template": "mcp_server:{name}",
      "stable_fields": [
        "name"
      ],
      "forbidden": [
        "analyzer",
        "source",
        "uuid",
        "timestamp",
        "array_index",
        "random"
      ],
      "notes": "Registered server name only. Configuration/source paths are evidence, not identity. Never includes analyzer/source names."
    }
  ],
  "evidence_rules": {

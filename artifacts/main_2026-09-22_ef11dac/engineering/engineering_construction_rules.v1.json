    "notes": "A graph object without evidence is not canonical engineering knowledge. Copy EvidenceRef entries from contributing M2 facts; do not invent paths or commits."
  },
  "unresolved_rules": {
    "reasons": [
      "target_not_resolved",
      "ambiguous_identity",
      "missing_endpoint",
      "unsupported_relationship"
    ],
    "container": "engineering.unresolved[]",
    "excluded_from_canonical_relationships": true,
    "required_fields": [
      "source",
      "target",
      "kind",
      "reason",
      "evidence"
    ],
    "notes": "Unresolved candidates retain the evidence that caused the unresolved state. They must not be inserted into canonical relationships[] and must not be given classification: unknown on a canonical edge."
  },
  "validation_rules": {
    "unique_node_ids": true,
    "unique_relationship_ids": true,
    "relationship_source_must_exist": true,
    "relationship_target_must_exist": true,
    "canonical_node_requires_evidence": true,
    "canonical_relationship_requires_evidence": true,
    "deterministic_node_identity": true,
    "deterministic_relationship_identity": true,
    "deterministic_output_order": true,
    "unresolved_claims_excluded_from_canonical_relationships": true,
    "no_analyzer_name_in_entity_identity": true,
    "no_random_ids_for_canonical_entities": true,
    "no_duplicate_physical_artifact_nodes": true,
    "notes": "no_duplicate_physical_artifact_nodes means multiple M2 fact classifications of the same path must not yield multiple artifact:file nodes (specialized artifact:* nodes with distinct subkinds are intentional separate engineering views)."
  },

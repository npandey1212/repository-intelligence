{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/repository_facts.v2.json",
  "title": "repository_facts.v2",
  "description": "Generic deterministic fact inventory for a repository snapshot. repository = identity/metadata only; facts[] = single canonical observation store (open fact_type/kind). Adding an analyzer adds facts, not root fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot", "repository", "facts", "analyzers"],
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where a fact was observed (provenance only; not interpretation).",
      "required": ["path", "artifact_type", "commit"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative source path (never absolute)."
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "python",
            "configuration",
            "agent_definition",
            "mcp_definition",
            "documentation",
            "test",
            "file",
            "directory"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Must equal snapshot.commit_sha."
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "FactRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "One observed fact. fact_type and kind are open strings so new fact kinds require no schema change.",
      "required": ["fact_id", "fact_type", "kind", "source", "attributes", "evidence"],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "description": "Deterministic stable identity: fact:<fact_type>:<stable-key>."
        },
        "fact_type": {
          "type": "string",
          "minLength": 1,
          "description": "Open vocabulary (initial: file, directory, entity, import, dependency, configuration, artifact, documentation, test). Filesystem facts use kind repository_file / repository_directory."
        },
        "kind": {
          "type": "string",
          "description": "Open sub-kind within fact_type (e.g. module/class/function, json/yaml, agent_definition)."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Producing analyzer or stage (filesystem, python, configuration, dependencies, agents, mcp, documentation, tests, entities)."
        },
        "attributes": {
          "type": "object",
          "description": "Analyzer-specific payload. Open for extension.",
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "description": "Provenance pointers (0..n). Meaningful path-backed facts must carry at least one entry (invariant).",
          "items": { "$ref": "#/$defs/EvidenceRef" }
        }
      }
    },
    "AnalyzerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repository_facts.v2"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "snapshot_id", "repository_url"],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "M1 commit SHA this facts document is bound to."
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "description": "Repository identity/metadata only. Canonical repository observations (files, directories, …) live exclusively in facts[].",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "facts": {
      "type": "array",
      "description": "Single canonical observation store for every analyzer, including repository files/directories (fact_type file/directory).",
      "items": { "$ref": "#/$defs/FactRecord" }
    },
    "analyzers": {
      "type": "array",
      "minItems": 1,
      "description": "Analyzer suite(s) that produced this document.",
      "items": { "$ref": "#/$defs/AnalyzerRef" }
    }
  }
}
